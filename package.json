    "drizzle-orm": "^0.45.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.5.24",
    "nodemailer": "^9.0.1",
    "postcss": "^8.5.6",
    "razorpay": "^2.9.6",
    "react": "^19.2.1",
